# ──────────────────────────────────────────────────────
#  AgentMail Webhook — Environment Variables
#  1. Copy this file to .env.local
#  2. Fill in your real values
#  3. NEVER commit .env.local to Git
# ──────────────────────────────────────────────────────

# Your AgentMail API key
# Get it from: https://console.agentmail.to → API Keys
AGENTMAIL_API_KEY=am_your_api_key_here

# Webhook signing secret — you get this AFTER running: node setup.js
# Looks like: whsec_xxxxxxxxxxxxxxxxxxxxxxxx
AGENTMAIL_WEBHOOK_SECRET=whsec_your_secret_here
